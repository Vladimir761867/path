<div class="overlay" id="overlay" role="dialog" aria-modal="true" aria-labelledby="modalTitle"><div class="modal"><button class="close" id="close" aria-label="Закрыть">×</button><span class="kicker" id="modalKicker">Маленький шаг</span><h2 id="modalTitle"></h2><p id="modalDesc"></p><div id="modalBody"></div><div class="actions" id="modalActions"></div></div></div>
<script>
const $=s=>document.querySelector(s), $$=s=>[...document.querySelectorAll(s)];
const practices={
  breathe:{symbol:'◌',title:'Мягкое дыхание',duration:'2 минуты',desc:'Замедлиться и почувствовать опору.',text:'Дыши комфортно, без задержки и усилия. На вдохе круг расширяется, на выдохе сужается. Если кружится голова, остановись и дыши обычно.',kind:'breathe'},
  ground:{symbol:'✳',title:'Вернуться в момент',duration:'1 минута',desc:'Переключить внимание на то, что вокруг.',text:'Назови 5 вещей, которые видишь; 4, которые ощущаешь телом; 3 звука. Не спеши. Сейчас ты здесь.',kind:'text'},
  boundary:{symbol:'↗',title:'Слова и границы',duration:'2 минуты',desc:'Когда чужие слова задели слишком сильно.',text:'Представь между собой и резкими словами прозрачное стекло. Слова остаются по ту сторону. Спроси себя: что из сказанного относится к задаче, а что говорит о состоянии другого человека?',kind:'text'},
  note:{symbol:'✎',title:'Разложить по полочкам',duration:'3 минуты',desc:'Отделить событие от мыслей о нём.',text:'Запиши три короткие строки: 1) Что произошло? 2) Что я сейчас чувствую? 3) Какой один небольшой шаг мне доступен? Не нужно искать идеальное решение.',kind:'note'},
  kindness:{symbol:'♡',title:'Тёплая фраза',duration:'1 минута',desc:'Поддержать себя без требования быть сильнее.',text:'Если бы близкий человек оказался на твоём месте, что бы ты сказала ему? Попробуй обратиться с этой же фразой к себе.',kind:'text'},
  reset:{symbol:'☀',title:'Смена обстановки',duration:'3 минуты',desc:'Вода, движение или немного воздуха.',text:'Если есть возможность, встань, сделай несколько спокойных шагов и выпей воды. Посмотри в окно или выйди на воздух. Потом проверь, изменилось ли что-то хотя бы на один процент.',kind:'text'}
};
let state={phase:'mood',mood:null,cause:null,currentPractice:null};
const history=()=>{try{return JSON.parse(localStorage.getItem('ryadom-history')||'[]')}catch{return []}};
const save=(list)=>{localStorage.setItem('ryadom-history',JSON.stringify(list));renderHistory()};
const dialogues=()=>{try{return JSON.parse(localStorage.getItem('ryadom-dialogues-v1')||'[]')}catch{return []}};
let activeDialogueId=null,pendingTranscript=[];
function recordDialogue(text,me){let message={role:me?'me':'mentor',text,at:new Date().toISOString()};pendingTranscript.push(message);if(!activeDialogueId&&!me)return;let all=dialogues();if(!activeDialogueId){activeDialogueId='d-'+Date.now()+'-'+Math.random().toString(36).slice(2,7);all.push({id:activeDialogueId,day:todayKey(),startedAt:new Date().toISOString(),messages:[...pendingTranscript]})}else{let session=all.find(x=>x.id===activeDialogueId);if(session)session.messages.push(message)}pendingTranscript=[];try{localStorage.setItem('ryadom-dialogues-v1',JSON.stringify(all.slice(-365)))}catch{}}
function add(text,me=false){const el=document.createElement('div');el.className='bubble'+(me?' me':'');el.textContent=text;$('#messages').append(el);$('#messages').scrollTop=$('#messages').scrollHeight;recordDialogue(text,me)}
function choices(options){const row=document.createElement('div');row.className='choices';options.forEach(([label,value])=>{let b=document.createElement('button');b.className='choice';b.textContent=label;b.onclick=()=>respond(label,value);row.append(b)});$('#messages').append(row);$('#messages').scrollTop=$('#messages').scrollHeight}
function clearChoices(){ $$('.messages .choices').forEach(e=>e.remove()) }
function start(){add('Привет. Как ты себя чувствуешь прямо сейчас?');choices([['Хорошо','good'],['Нормально','okay'],['Тревожно','anxious'],['Злюсь','angry'],['Очень тяжело','hard']])}
function classify(s,phase){s=s.toLowerCase();if(/суицид|поконч|убить себя|не хочу жить|хочу умереть|лучше бы умер|навредить себе|самоповрежд|самоубий|suicid|kill myself/.test(s))return 'crisis';if(phase==='mood'){if(['good','okay','anxious','angry','hard'].includes(s))return s;if(/ужас|плох|тяжел|груст|депресс|плачу/.test(s))return 'hard';if(/тревог|страш|паник|пережив/.test(s))return 'anxious';if(/злю|бесит|раздраж|ярост/.test(s))return 'angry';if(/хорош|отлич|радост|счаст/.test(s))return 'good';return 'okay'}if(phase==='cause'){if(['work','people','tired','unknown','other'].includes(s))return s;if(/началь|руковод|шеф|босс|работ|коллег/.test(s))return 'work';if(/семь|муж|жен|партнер|партнёр|друг|ссор|отнош/.test(s))return 'people';if(/устал|сон|спал|выгор|сил/.test(s))return 'tired';if(/не знаю|непонят|без причин/.test(s))return 'unknown';return 'other'}return s}
function respond(label,value){clearChoices();if(value==='restart'){activeDialogueId=null;pendingTranscript=[]}add(label,true);let v=classify(value,state.phase);if(v==='crisis'){state.phase='crisis';add('Мне жаль, что сейчас настолько тяжело. Если есть риск, что ты можешь причинить себе вред, пожалуйста, обратись за срочной помощью по местному экстренному номеру или к человеку рядом прямо сейчас. Можно написать близкому: «Мне сейчас небезопасно одной/одному. Побудь со мной и помоги обратиться за помощью».');choices([['Показать текст для близкого','help'],['Я сейчас в безопасности','safe']]);return}
if(state.phase==='crisis'){if(value==='help')add('Скопируй и отправь: «Мне сейчас очень тяжело. Пожалуйста, побудь со мной или позвони мне сейчас. Помоги обратиться за срочной помощью».');else add('Спасибо, что сказала. Можно обратиться к близкому человеку или специалисту и не оставаться с этим в одиночку.');choices([['Начать заново','restart']]);state.phase='end';return}
if(state.phase==='mood'){state.mood=v;let arr=history();arr.push({day:todayKey(),mood:v});save(arr.slice(-365));$('#lastMood').textContent=({good:'Хорошо',okay:'Нормально',anxious:'Тревожно',angry:'Злюсь',hard:'Тяжело'})[v];if(v==='good'){add('Рада это слышать. Хочешь сохранить ощущение или просто побыть в нём?');choices([['Отмечу, что помогло','note'],['Просто побуду','pause'],['Есть и сложная часть','complex']]);state.phase='positive';return}add(v==='hard'?'Похоже, сегодня правда непросто. Что больше всего повлияло?':v==='angry'?'Понимаю. Что задело сильнее всего?':v==='anxious'?'Давай разберёмся без спешки. С чем связана тревога?':'Что сегодня занимает больше всего места в мыслях?');choices([['Работа или начальник','work'],['Отношения','people'],['Усталость','tired'],['Не знаю','unknown']]);state.phase='cause';return}
if(state.phase==='positive'){if(value==='complex'){state.phase='cause';add('Что сейчас волнует?');choices([['Работа','work'],['Отношения','people'],['Усталость','tired'],['Не знаю','unknown']]);return}if(value==='note')openPractice('note');else add('Побудь в этом моменте столько, сколько хочется. Я рядом, если понадоблюсь.');state.phase='end';choices([['Начать новый разговор','restart']]);return}
if(state.phase==='cause'){state.cause=v;let lines={work:'Когда начальник резко говорит, это может сильно выбить из равновесия. Что было бы полезнее сейчас?',people:'Сложные разговоры с близкими правда ранят. Что тебе сейчас нужнее?',tired:'Когда сил мало, даже мелочи ощущаются тяжелее. Что сейчас доступно?',unknown:'Не обязательно сразу понимать причину. Начнём с самого простого?',other:'Спасибо, что рассказала. Что могло бы помочь прямо сейчас?'};add(lines[v]||lines.other);let opts=v==='work'?[['Сначала успокоиться','breathe'],['Отделить слова от себя','boundary'],['Разложить ситуацию','note']]:v==='tired'?[['Сделать паузу','reset'],['Мягко подышать','breathe'],['Поддержать себя','kindness']]:[['Вернуться в момент','ground'],['Разложить мысли','note'],['Поддержать себя','kindness']];choices(opts);state.phase='suggest';return}
if(state.phase==='suggest'){if(practices[value]){state.currentPractice=value;add('Хороший выбор. Можно попробовать сейчас; если не подойдёт, сменим способ.');openPractice(value);state.phase='afterPractice'}return}
if(state.phase==='afterPractice'){if(value==='better'||value==='same'||value==='worse'){let arr=history();arr.push({day:todayKey(),practice:state.currentPractice,outcome:value});save(arr.slice(-365));add(value==='better'?'Рада, что стало хоть немного легче. Что помогло больше всего?':value==='worse'?'Жаль, что стало тяжелее. Давай не продолжать эту практику. Можно связаться с близким человеком или выбрать другой, более мягкий шаг.':'Спасибо, что заметила. Иногда эффект не приходит сразу. Хочешь попробовать другой способ?');choices([['Другой способ','another'],['Закончить на сегодня','finish']]);state.phase='followup';return} }
if(state.phase==='followup'){if(value==='another'){add('Выбери то, что сейчас кажется посильным.');choices([['Мягкое дыхание','breathe'],['Вернуться в момент','ground'],['Смена обстановки','reset'],['Тёплая фраза','kindness']]);state.phase='suggest'}else{add('Спасибо, что уделила себе это время. Можно вернуться в любой момент.');choices([['Начать заново','restart']]);state.phase='end'}return}
if(value==='restart'){state={phase:'mood',mood:null,cause:null,currentPractice:null};add('Начнём заново. Как ты сейчас?');choices([['Хорошо','good'],['Нормально','okay'],['Тревожно','anxious'],['Злюсь','angry'],['Очень тяжело','hard']])}}
$('#form').onsubmit=e=>{e.preventDefault();const v=$('#input').value.trim();if(!v)return;$('#input').value='';respond(v,v)};
function openPractice(key){const p=practices[key];if(!p)return;state.currentPractice=key;$('#modalKicker').textContent=p.duration;$('#modalTitle').textContent=p.title;$('#modalDesc').textContent=p.text;$('#modalBody').replaceChildren();$('#modalActions').replaceChildren();if(p.kind==='breathe'){let orb=document.createElement('div');orb.className='orb';$('#modalBody').append(orb);let b=document.createElement('button');b.className='primary';b.textContent='Начать дыхание';b.onclick=()=>{orb.classList.add('breathe');b.textContent='Дыши в своём ритме';b.disabled=true};$('#modalActions').append(b)}else if(p.kind==='note'){let inp=document.createElement('textarea');inp.placeholder='Твои мысли остаются только на этом экране и не сохраняются';inp.setAttribute('aria-label','Заметка');inp.style.cssText='width:100%;height:100px;border:1px solid #dbe6dc;border-radius:12px;padding:12px;font:inherit;resize:vertical;background:#fbfaf6';$('#modalBody').append(inp)}else{let sym=document.createElement('div');sym.style.cssText='font-size:70px;color:#6e9a7a;margin:18px';sym.textContent=p.symbol;$('#modalBody').append(sym)}let done=document.createElement('button');done.className='secondary';done.textContent='Закончить';done.onclick=()=>{closeModal();if(state.phase==='afterPractice')askFeedback();else{state.phase='afterPractice';askFeedback()}};$('#modalActions').append(done);$('#overlay').classList.add('show')}
function askFeedback(){add('Как ты сейчас после этого шага?');choices([['Чуть легче','better'],['Пока так же','same'],['Стало хуже','worse']]);state.phase='afterPractice'}
function closeModal(){$('#overlay').classList.remove('show')}$('#close').onclick=closeModal;$('#overlay').onclick=e=>{if(e.target.id==='overlay')closeModal()};document.onkeydown=e=>{if(e.key==='Escape')closeModal()};
function renderHistory(){let data=history(), moods=data.filter(x=>x.mood).slice(-7), map={good:5,okay:4,anxious:2,angry:2,hard:1};$('#bars').replaceChildren();if(!moods.length){$('#bars').innerHTML='<p class="empty">Здесь появятся твои отметки после первого разговора.</p>'}else moods.forEach((m,i)=>{let c=document.createElement('div');c.className='barcol';let b=document.createElement('div');b.className='bar '+((map[m.mood]||1)>3?'hi':'');b.style.height=((map[m.mood]||1)*32)+'px';c.append(b,document.createTextNode('День '+(i+1)));$('#bars').append(c)});$('#historyText').textContent=moods.length?`Отмечено состояний: ${moods.length}. График показывает только твои ответы, без оценок и диагнозов.`:'Одна короткая отметка в день — уже начало.';let outcomes=data.filter(x=>x.outcome==='better'&&x.practice), counts={};outcomes.forEach(x=>counts[x.practice]=(counts[x.practice]||0)+1);let best=Object.entries(counts).sort((a,b)=>b[1]-a[1])[0];$('#helpText').textContent=best?`Чаще всего тебе помогала практика «${practices[best[0]]?.title||best[0]}» (${best[1]} раз). Это личная заметка, не медицинский вывод.`:'Когда ты попробуешь практику и оценишь её, здесь появятся твои наблюдения.';let last=[...data].reverse().find(x=>x.mood);if(last)$('#lastMood').textContent=({good:'Хорошо',okay:'Нормально',anxious:'Тревожно',angry:'Злюсь',hard:'Тяжело'})[last.mood]}
function view(id){$$('.section').forEach(el=>el.classList.toggle('active',el.id===id));$$('[data-view]').forEach(el=>el.classList.toggle('active',el.dataset.view===id));if(id==='history')renderHistory();window.scrollTo(0,0)}$$('[data-view]').forEach(b=>b.onclick=()=>view(b.dataset.view));$('#clearData').onclick=()=>{if(confirm('Удалить все отметки из этого браузера?')){localStorage.removeItem('ryadom-history');renderHistory()}};
const todayKey=()=>{const d=new Date();return [d.getFullYear(),String(d.getMonth()+1).padStart(2,'0'),String(d.getDate()).padStart(2,'0')].join('-')};
const checkins=()=>{try{return JSON.parse(localStorage.getItem('ryadom-checkins')||'[]')}catch{return []}};
let analyticsPeriod=7, analyticsMetric='anxiety';
const metricInfo={anxiety:{name:'Тревога',color:'#d2967f'},sadness:{name:'Грусть',color:'#a88eb0'},restlessness:{name:'Беспокойство',color:'#d5ae70'},calm:{name:'Спокойствие',color:'#75a88a'}};
function periodEntries(){let start=new Date();start.setDate(start.getDate()-analyticsPeriod+1);let lower=[start.getFullYear(),String(start.getMonth()+1).padStart(2,'0'),String(start.getDate()).padStart(2,'0')].join('-');let upper=todayKey();return checkins().filter(x=>x.day>=lower&&x.day<=upper).sort((a,b)=>a.day.localeCompare(b.day))}
function renderChart(rows){let area=$('#lineChart');area.replaceChildren();if(!rows.length){area.innerHTML='<div class="chart-empty">Пока нет точек на графике. Поставь первую отметку выше.</div>';return}
  const width=650,height=205,pad=28,span=analyticsPeriod-1,start=new Date();start.setHours(12,0,0,0);start.setDate(start.getDate()-span);const xFor=day=>{let date=new Date(day+'T12:00:00');return pad+(date-start)/86400000/span*(width-2*pad)},yFor=v=>height-pad-v/4*(height-2*pad);
  const ns='http://www.w3.org/2000/svg',svg=document.createElementNS(ns,'svg');svg.setAttribute('viewBox','0 0 650 205');svg.setAttribute('role','img');svg.setAttribute('aria-label',metricInfo[analyticsMetric].name+' по дням');
  [0,1,2,3,4].forEach(v=>{let line=document.createElementNS(ns,'line');line.setAttribute('x1',pad);line.setAttribute('x2',width-pad);line.setAttribute('y1',yFor(v));line.setAttribute('y2',yFor(v));line.setAttribute('stroke','#e8ece5');line.setAttribute('stroke-dasharray',v===0?'0':'3 5');svg.append(line);let t=document.createElementNS(ns,'text');t.setAttribute('x','5');t.setAttribute('y',yFor(v)+4);t.setAttribute('fill','#829087');t.setAttribute('font-size','10');t.textContent=v;svg.append(t)});
  let sorted=rows.filter(x=>Number.isFinite(Number(x[analyticsMetric]))),parts=[];sorted.forEach((r,i)=>{let x=xFor(r.day),y=yFor(Number(r[analyticsMetric]));parts.push((i?'L':'M')+x.toFixed(1)+' '+y.toFixed(1))});if(parts.length>1){let path=document.createElementNS(ns,'path');path.setAttribute('d',parts.join(' '));path.setAttribute('fill','none');path.setAttribute('stroke',metricInfo[analyticsMetric].color);path.setAttribute('stroke-width','3');path.setAttribute('stroke-linejoin','round');svg.append(path)}
  sorted.forEach(r=>{let dot=document.createElementNS(ns,'circle');dot.setAttribute('cx',xFor(r.day));dot.setAttribute('cy',yFor(Number(r[analyticsMetric])));dot.setAttribute('r','5');dot.setAttribute('fill',metricInfo[analyticsMetric].color);dot.setAttribute('stroke','#fffdf9');dot.setAttribute('stroke-width','2');let title=document.createElementNS(ns,'title');title.textContent=r.day+': '+metricInfo[analyticsMetric].name.toLowerCase()+' '+r[analyticsMetric]+' из 4';dot.append(title);svg.append(dot)});
  area.append(svg);let labels=document.createElement('div');labels.className='legend';let fmt=s=>new Date(s+'T12:00:00').toLocaleDateString('ru-RU',{day:'numeric',month:'short'});labels.innerHTML='<span>'+fmt(start.toISOString().slice(0,10))+'</span><span>Сегодня</span>';area.append(labels)
}
renderHistory=function(){let rows=periodEntries(),n=rows.length;function stat(id,caption,key){let num=rows.filter(x=>Number(x[key])>=3).length;$(id).textContent=n?num+' / '+n:'—';$(caption).textContent=n?'дней с отметкой 3–4 из 4':'Нет отметок'}stat('#anxietyStat','#anxietyCaption','anxiety');stat('#sadnessStat','#sadnessCaption','sadness');stat('#calmStat','#calmCaption','calm');renderChart(rows);
  let all=history(),outcomes=all.filter(x=>x.outcome==='better'&&x.practice),counts={};outcomes.forEach(x=>counts[x.practice]=(counts[x.practice]||0)+1);let best=Object.entries(counts).sort((a,b)=>b[1]-a[1])[0];$('#helpText').textContent=best?`Чаще всего тебе помогала практика «${practices[best[0]]?.title||best[0]}» (${best[1]} раз). Это личная заметка, не медицинский вывод.`:'Когда ты попробуешь практику и оценишь её, здесь появятся твои наблюдения.';
  let last=[...all].reverse().find(x=>x.mood);$('#lastMood').textContent=last?({good:'Хорошо',okay:'Нормально',anxious:'Тревожно',angry:'Злюсь',hard:'Тяжело'})[last.mood]:'Пока нет';
  let strong=rows.filter(x=>Number(x.anxiety)>=3).length;$('#insightText').textContent=n<3?'После трёх отметок здесь появится короткое наблюдение. Пропущенные дни не учитываются.':strong>=Math.ceil(n/2)?`В ${strong} из ${n} отмеченных дней тревога была сильной. Можно посмотреть, что происходило в эти дни, и обратиться за поддержкой, если это мешает жить.`:`За выбранный период сильная тревога отмечалась в ${strong} из ${n} дней. Посмотри, какие занятия и разговоры помогали тебе чувствовать себя спокойнее.`;
  let t=checkins().find(x=>x.day===todayKey());$('#checkinStatus').textContent=t?'Сегодняшняя отметка сохранена. Её можно изменить.':'Можно отмечать раз в день. Сегодняшнюю отметку можно изменить.';renderCalendar();
};
let calendarMonth=new Date(),selectedDay=todayKey();
const localDay=(y,m,d)=>[y,String(m+1).padStart(2,'0'),String(d).padStart(2,'0')].join('-');
const moodNames={good:'Хорошо',okay:'Нормально',anxious:'Тревожно',angry:'Злюсь',hard:'Очень тяжело'};
function renderCalendar(){let y=calendarMonth.getFullYear(),m=calendarMonth.getMonth(),grid=$('#calendarGrid');grid.replaceChildren();$('#monthTitle').textContent=new Intl.DateTimeFormat('ru-RU',{month:'long',year:'numeric'}).format(calendarMonth);$('#nextMonth').disabled=y===new Date().getFullYear()&&m===new Date().getMonth();let first=(new Date(y,m,1).getDay()+6)%7,days=new Date(y,m+1,0).getDate();for(let i=0;i<first;i++){let blank=document.createElement('span');blank.setAttribute('aria-hidden','true');grid.append(blank)}let marks=history(),notes=checkins();for(let d=1;d<=days;d++){let key=localDay(y,m,d),mood=[...marks].reverse().find(x=>x.day===key&&x.mood),check=notes.find(x=>x.day===key),b=document.createElement('button');b.className='calendar-day'+(mood?' mood-'+mood.mood:'')+(check?' has-data':'')+(key===todayKey()?' today':'')+(key===selectedDay?' selected':'');b.disabled=key>todayKey();b.setAttribute('aria-label',new Intl.DateTimeFormat('ru-RU',{weekday:'long',day:'numeric',month:'long'}).format(new Date(y,m,d))+(mood?', '+moodNames[mood.mood]:'')+(check?', есть отметка ощущений':''));let num=document.createElement('b');num.textContent=d;b.append(num);if(check){let dots=document.createElement('span');dots.className='day-dots';['anxiety','sadness','restlessness','calm'].forEach(k=>{let dot=document.createElement('i');if(Number(check[k])>=3)dot.className='high';dots.append(dot)});b.append(dots)}b.onclick=()=>{selectedDay=key;renderCalendar()};grid.append(b)}renderCalendarDetail()}
function renderCalendarDetail(){let panel=$('#calendarDetail');panel.replaceChildren();let date=new Date(selectedDay+'T12:00:00'),title=document.createElement('h4');title.textContent=new Intl.DateTimeFormat('ru-RU',{weekday:'long',day:'numeric',month:'long'}).format(date);panel.append(title);let marks=history().filter(x=>x.day===selectedDay),mood=[...marks].reverse().find(x=>x.mood),check=checkins().find(x=>x.day===selectedDay);if(!mood&&!check){let p=document.createElement('p');p.textContent='На этот день нет записи. Пустая клетка ничего не говорит о том, каким был день.';panel.append(p);return}if(mood){let p=document.createElement('p');p.textContent='В диалоге: '+moodNames[mood.mood];panel.append(p)}if(check){[['Тревога','anxiety'],['Грусть','sadness'],['Беспокойство','restlessness'],['Спокойствие','calm']].forEach(([label,key])=>{let row=document.createElement('div');row.className='detail-metric';let left=document.createElement('span');left.textContent=label;let right=document.createElement('strong');right.textContent=check[key]+' / 4';row.append(left,right);panel.append(row)});if(check.note){let n=document.createElement('p');n.className='detail-note';n.textContent=check.note;panel.append(n)}}let practice=marks.filter(x=>x.practice);if(practice.length){let p=document.createElement('p');p.textContent='Практики: '+practice.map(x=>(practices[x.practice]?.title||x.practice)+' — '+({better:'чуть легче',same:'без изменений',worse:'стало хуже'}[x.outcome]||'без оценки')).join('; ');panel.append(p)}}
$('#prevMonth').onclick=()=>{calendarMonth=new Date(calendarMonth.getFullYear(),calendarMonth.getMonth()-1,1);selectedDay=localDay(calendarMonth.getFullYear(),calendarMonth.getMonth(),1);renderCalendar()};
